                "HiyodoriBody": { "$path": "assets/meshes/HiyodoriBody.rbxm" },
                "HiyodoriWings": { "$path": "assets/meshes/HiyodoriWings.rbxm" }
            },
            "RoshamboRemotes": {
                "$className": "Folder",
