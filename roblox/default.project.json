        "StarterPlayer": {
            "$className": "StarterPlayer",
            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
                "RoshamboClient": { "$path": "src/client" }
            }
        },
        "ServerScriptService": {
            "Roshambo": { "$path": "src/server" }
