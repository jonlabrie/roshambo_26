{
    "name": "roshambo-roblox",
    "tree": {
        "$className": "DataModel",
        "HttpService": {
            "$className": "HttpService",
            "$properties": { "HttpEnabled": true }
        },
        "ReplicatedStorage": {
            "RoshamboShared": { "$path": "src/shared" },
            "RoshamboRemotes": {
                "$className": "Folder",
                "SubmitPick": { "$className": "RemoteEvent" },
                "BankRequest": { "$className": "RemoteEvent" },
                "SetHudPreference": { "$className": "RemoteEvent" },
                "RequestLedger": { "$className": "RemoteEvent" },
                "RoundUpdate": { "$className": "RemoteEvent" },
                "RevealResult": { "$className": "RemoteEvent" },
                "ProfileUpdate": { "$className": "RemoteEvent" },
                "RevealTheater": { "$className": "RemoteEvent" },
                "FateResolved": { "$className": "RemoteEvent" },
                "BoardData": { "$className": "RemoteEvent" },
                "RequestFireworkLaunch": { "$className": "RemoteEvent" },
                "FireworkLaunched": { "$className": "RemoteEvent" },
                "FireworkState": { "$className": "RemoteEvent" },
                "SetPadPreference": { "$className": "RemoteEvent" },
                "PreferenceState": { "$className": "RemoteEvent" },
                "SetBackDoor": { "$className": "RemoteEvent" },
                "BackDoorState": { "$className": "RemoteEvent" },
                "RequestPurchase": { "$className": "RemoteEvent" },
                "EconomyState": { "$className": "RemoteEvent" },
                "SetDisplay": { "$className": "RemoteEvent" },
                "SetPlacement": { "$className": "RemoteEvent" },
                "SetDecorationPlacement": { "$className": "RemoteEvent" },
                "SetDecorationRemove": { "$className": "RemoteEvent" },
                "DecorationPlaced": { "$className": "RemoteEvent" },
                "SetAccess": { "$className": "RemoteEvent" },
                "InviteUser": { "$className": "RemoteEvent" },
                "RevokeUser": { "$className": "RemoteEvent" },
                "AccessState": { "$className": "RemoteEvent" },
                "AccessBlocked": { "$className": "RemoteEvent" },
                "RequestSync": { "$className": "RemoteEvent" }
            }
        },
        "Workspace": {
            "$className": "Workspace",
            "RoshamboStage": {
                "$className": "Folder",
                "BonshoRig": { "$path": "assets/BonshoRig.model.json" },
                "BonshoBell": { "$path": "assets/meshes/BonshoBell.rbxm" },
                "Shoro": { "$path": "assets/Shoro.model.json" },
                "ShoroRoof": { "$path": "assets/meshes/ShoroRoof.rbxm" },
                "Waterwheel": { "$path": "assets/Waterwheel.model.json" },
                "BellDrive": { "$path": "assets/BellDrive.model.json" },
                "ThrowDrum": { "$path": "assets/ThrowDrum.model.json" },
                "RanmaCarvings": { "$path": "assets/meshes/RanmaCarvings.rbxm" },
                "Overlook": { "$path": "assets/Overlook.model.json" },
                "SwitchbackDeck": { "$path": "assets/SwitchbackDeck.model.json" },
                "FallsDock": { "$path": "assets/FallsDock.model.json" },
                "Karesansui": { "$path": "assets/Karesansui.model.json" },
                "ArenaSpawn": {
                    "$className": "SpawnLocation",
                    "$properties": { "Anchored": true, "Size": [8, 1, 8], "CFrame": [40, 113.2, 8, 0, 0, 1, 0, 1, 0, -1, 0, 0], "Neutral": true }
                }
            }
        },
        "StarterPlayer": {
            "$className": "StarterPlayer",
            "StarterPlayerScripts": {
                "$className": "StarterPlayerScripts",
                "RoshamboClient": { "$path": "src/client" }
            }
        },
        "ServerScriptService": {
            "Roshambo": { "$path": "src/server" }
        }
    }
}
