{
    "name": "roshambo-roblox",
    "tree": {
        "$className": "DataModel",
        "HttpService": {
            "$className": "HttpService",
            "$properties": { "HttpEnabled": true }
        },
        "ReplicatedStorage": {
            "RoshamboShared": { "$path": "src/shared" },
            "RoshamboBirds": {
                "$className": "Folder",
                "UguisuBody": { "$path": "assets/meshes/UguisuBody.rbxm" },
                "UguisuWings": { "$path": "assets/meshes/UguisuWings.rbxm" },
