-- hangShellPosters.luau — the hanabiya's shell posters (2026-09-03)
--
-- HOW TO RUN: paste into the Studio command bar in EDIT mode, eyeball the shop interior,
-- then SAVE AND PUBLISH. Idempotent: destroys its own folder before rebuilding.
--
-- Twelve hanabi-catalog posters, one per shell, generated by
-- roblox/tools/textures/make_shell_posters.py from each shell's ACTUAL recipe data and
-- owner-approved 2026-09-03 (style gate on the Peony; wa/yashi/janken revised at the set
-- gate — rings on edge, arm-end clusters, canonical-glyph cascade). The asset ids below
-- are the uploads of that approved set; regenerate + re-upload + re-bake to change them.
--
-- Layout: four per solid interior wall (west / back / east; the south wall is the lattice
-- doors), catalog order, eye height. Each poster is a dark board (the signage palette)
-- carrying the artwork and a Josefin Sans nameplate — name and price, the price mirroring
-- server/src/fireworks.ts SHELL_PRICES (a price change there must re-bake here).
--
-- Place-only, own folder: the Hanabiya model is Rojo-managed, so the posters hang in
-- Workspace.CanyonWorld.ShellPosters positioned against its interior walls.

local BOARD = Color3.fromRGB(45, 48, 56)
local CREAM = Color3.fromRGB(240, 234, 216)
local GOLD = Color3.fromRGB(212, 176, 102)

-- { id, display name, price (pts), poster asset }
local POSTERS = {
    { "firecracker", "Bottle Rocket", 1, "rbxassetid://107858275523167" },
    { "peony", "Peony", 3, "rbxassetid://138979012660700" },
    { "willow", "Willow", 4, "rbxassetid://106360833665113" },
    { "ishibana", "Ishibana", 6, "rbxassetid://95803177187613" },
    { "kiku", "Kiku", 4, "rbxassetid://123469190737607" },
    { "wa", "Wa", 5, "rbxassetid://96099620546033" },
    { "yashi", "Yashi", 10, "rbxassetid://83249636238878" },
    { "kamuro", "Kamuro", 10, "rbxassetid://120145517519591" },
    { "hotaru", "Hotaru", 8, "rbxassetid://121382908447854" },
    { "janken", "Janken", 12, "rbxassetid://83403684561798" },
    { "rai", "Rai", 4, "rbxassetid://124793820600997" },
    { "banrai", "Banrai", 7, "rbxassetid://78338551438220" },
}

-- Interior faces measured live 2026-09-03: WallWest inner X=-0.85 (posters face +X),
-- WallBack inner Z=51.25 (face -Z), WallEast inner X=15.45 (face -X). Wall band Y
-- 113.1..122.1; boards centred at eye height.
local BOARD_W, BOARD_H, BOARD_T = 3.0, 4.9, 0.15
local BOARD_Y = 117.8
local SLOTS = {
    -- west wall, catalog 1-4, spaced along Z
    {
        pos = function(i)
            return Vector3.new(-0.85 + BOARD_T / 2 + 0.02, BOARD_Y, 39.3 + (i - 1) * 3.2)
        end,
        look = Vector3.new(1, 0, 0),
    },
    -- back wall, catalog 5-8, spaced along X
    {
        pos = function(i)
            return Vector3.new(2.5 + (i - 1) * 3.2, BOARD_Y, 51.25 - BOARD_T / 2 - 0.02)
        end,
        look = Vector3.new(0, 0, -1),
    },
    -- east wall, catalog 9-12
    {
        pos = function(i)
            return Vector3.new(15.45 - BOARD_T / 2 - 0.02, BOARD_Y, 39.3 + (i - 1) * 3.2)
        end,
        look = Vector3.new(-1, 0, 0),
    },
}

local canyonWorld = workspace:FindFirstChild("CanyonWorld")
assert(canyonWorld, "Workspace.CanyonWorld is missing — is this the right place?")

local old = canyonWorld:FindFirstChild("ShellPosters")
if old then
    old:Destroy()
end
local folder = Instance.new("Folder")
folder.Name = "ShellPosters"
folder.Parent = canyonWorld

for n, row in POSTERS do
    local wall = SLOTS[math.ceil(n / 4)]
    local slot = ((n - 1) % 4) + 1
    local board = Instance.new("Part")
    board.Name = "Poster_" .. row[1]
    board.Size = Vector3.new(BOARD_W, BOARD_H, BOARD_T)
    local pos = wall.pos(slot)
    board.CFrame = CFrame.lookAt(pos, pos + wall.look)
    board.Anchored = true
    board.CanCollide = false
    board.CastShadow = false
    board.Material = Enum.Material.Wood
    board.Color = BOARD
    board.Parent = folder

    local gui = Instance.new("SurfaceGui")
    gui.Face = Enum.NormalId.Front
    gui.CanvasSize = Vector2.new(300, 490)
    gui.LightInfluence = 0.3
    gui.Brightness = 1.4
    gui.Parent = board

    local art = Instance.new("ImageLabel")
    art.BackgroundTransparency = 1
    art.Size = UDim2.new(1, -16, 0, 400)
    art.Position = UDim2.fromOffset(8, 8)
    art.Image = row[4]
    art.ScaleType = Enum.ScaleType.Fit
    art.Parent = gui

    local plate = Instance.new("TextLabel")
    plate.BackgroundTransparency = 1
    plate.Size = UDim2.new(1, -16, 0, 46)
    plate.Position = UDim2.fromOffset(8, 412)
    plate.FontFace = Font.new("rbxasset://fonts/families/JosefinSans.json", Enum.FontWeight.SemiBold)
    plate.TextColor3 = CREAM
    plate.TextScaled = true
    plate.Text = row[2]
    plate.Parent = gui

    local price = Instance.new("TextLabel")
    price.BackgroundTransparency = 1
    price.Size = UDim2.new(1, -16, 0, 24)
    price.Position = UDim2.fromOffset(8, 458)
    price.FontFace = Font.new("rbxasset://fonts/families/JosefinSans.json", Enum.FontWeight.Regular)
    price.TextColor3 = GOLD
    price.TextScaled = true
    price.Text = row[3] .. " pts"
    price.Parent = gui
end

print(
    ("[ShellPosters] %d posters hung on the hanabiya's three walls. Eyeball, then SAVE AND PUBLISH."):format(
        #POSTERS
    )
)
